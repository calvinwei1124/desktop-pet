{
  "name": "cartoon-desktop-pet",
  "version": "1.0.0",
  "description": "桌面宠物 App（类似 PawPal）：内置机器猫、葫芦兄弟、齐天大圣、舒克和贝塔、邋遢大王，支持自由扩展角色",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg",
    "dist:app": "electron-builder --mac dir",
    "dist:dmg": "electron-builder --mac dmg"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.marten.cartoonpet",
    "productName": "卡通桌面宠物",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "style.css",
      "settings.html",
      "settings.js",
      "characters.js",
      "assets/**/*",
      "!assets/.original/**"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.entertainment",
      "target": ["dmg"],
      "icon": "icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "卡通桌面宠物",
      "icon": "icon.icns"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3"
  }
}
